{
  "name": "@ticketpay/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:deploy": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "posters": "tsx src/posters.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
