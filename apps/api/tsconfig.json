{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "moduleResolution": "node",
    "declaration": false, "removeComments": true, "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "strict": true, "strictPropertyInitialization": false, "esModuleInterop": true, "skipLibCheck": true,
    "sourceMap": true, "outDir": "./dist"
  },
  "include": ["src", "test"]
}
