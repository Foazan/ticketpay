# ---------------------------------------------------------------
# TicketPay environment. Copy to .env and fill in. Never commit .env.
# This is an academic prototype: sandbox payments, testnet tickets.
# ---------------------------------------------------------------

# --- Database and cache (matches infrastructure/docker-compose.yml) ---
DATABASE_URL=postgresql://ticketpay:ticketpay@localhost:5432/ticketpay?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
# Public URL of the API. Only needed when it differs from http://localhost:API_PORT (for example behind ngrok).
API_PUBLIC_URL=
# Generate the three secrets below with: pnpm secrets
# WEBHOOK_SECRET_ENC_KEY encrypts merchant webhook secrets at rest (64 hex characters). Required.
JWT_SECRET=
WEBHOOK_SECRET_ENC_KEY=
CUSTODIAL_MASTER_SECRET=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Payments. mock = labelled demo payments, midtrans = Snap Sandbox ---
PAYMENT_PROVIDER=mock
# Midtrans dashboard (Sandbox environment) > Settings > Access Keys. Server key stays on the API only.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Only false is supported: this prototype never talks to the Midtrans production environment.
MIDTRANS_IS_PRODUCTION=false
# Comma-separated subset of VA,QRIS,EWALLET that is active in your sandbox account. Checkout shows only these.
MIDTRANS_ENABLED_METHODS=VA,QRIS,EWALLET
# Confirm each notification with Midtrans' Get Status API before applying it. Keep true.
MIDTRANS_VERIFY_STATUS=true

# --- Background jobs (Redis + BullMQ) ---
# Run the webhook and expiry workers inside the API process.
RUN_WORKERS=true
# Merchant webhook retries: first delay in ms, doubling each attempt, up to the max attempts.
WEBHOOK_RETRY_BASE_MS=30000
WEBHOOK_MAX_ATTEMPTS=6
# Wait this long after a 15-minute hold ends before expiring the order, for late provider notifications.
EXPIRY_GRACE_MS=120000

# --- Blockchain (Phase 5). disabled | local | sepolia ---
CHAIN_MODE=disabled
SEPOLIA_RPC_URL=
CHAIN_ID=11155111
TICKET_CONTRACT_ADDRESS=
# Test-only wallets funded from a Sepolia faucet. Never reuse a real wallet.
DEPLOYER_PRIVATE_KEY=
SIGNER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
