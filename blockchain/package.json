{
  "name": "@ticketpay/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "TicketPayTicket ERC-721 contract, tests and deploy scripts",
  "main": "export/index.js",
  "types": "export/index.d.ts",
  "scripts": {
    "compile": "hardhat compile && node scripts/export-artifact.js",
    "test": "hardhat test",
    "node": "hardhat node --hostname 127.0.0.1 --port 8545",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "typecheck": "hardhat compile --quiet && tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.4",
    "@openzeppelin/contracts": "^5.4.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.2",
    "solc": "0.8.28",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.7.2"
  }
}
